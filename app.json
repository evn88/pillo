{
  "expo": {
    "name": "Pillo",
    "slug": "pillo",
    "version": "1.0.0",
    "scheme": "pillo",
    "platforms": ["ios", "android"],
    "icon": "./assets/icon-pillo.png",
    "splash": {
      "image": "./assets/splash-icon-pillo.png",
      "resizeMode": "contain",
      "backgroundColor": "#17104F"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vershkov.pillo"
    },
    "android": {
      "package": "com.vershkov.pillo",
      "adaptiveIcon": {
        "backgroundColor": "#17104F",
        "foregroundImage": "./assets/android-icon-foreground-pillo.png",
        "monochromeImage": "./assets/android-icon-monochrome-pillo.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon-pillo.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
