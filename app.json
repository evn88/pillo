{
  "expo": {
    "name": "PillDan",
    "slug": "pilldan",
    "version": "1.0.0",
    "scheme": [
      "pilldan",
      "pillo"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon-pilldan.png",
    "splash": {
      "image": "./assets/splash-icon-pilldan.png",
      "resizeMode": "contain",
      "backgroundColor": "#17104F"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vershkov.pillo"
    },
    "android": {
      "allowBackup": false,
      "package": "com.vershkov.pillo",
      "adaptiveIcon": {
        "backgroundColor": "#17104F",
        "foregroundImage": "./assets/android-icon-foreground-pilldan.png",
        "monochromeImage": "./assets/android-icon-monochrome-pilldan.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon-pilldan.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Выберите фото упаковки препарата для его карточки.",
          "cameraPermission": "Разрешите снять упаковку препарата для его карточки.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
